[3.425, "o", "\r\n"]
[3.495, "o", "\u001b[1mgpu-doctor 0.1.0\u001b[0m: read-only NVIDIA driver diagnostics\r\n"]
[3.565, "o", "\r\n"]
[3.635, "o", "\u001b[32mPASS\u001b[0m  System information                   Ubuntu 24.04.1 LTS, kernel 6.8.0-47-generic, x86_64\r\n"]
[3.705, "o", "\u001b[32mPASS\u001b[0m  NVIDIA GPU present                   1 NVIDIA GPU: AD102 [GeForce RTX 4090] (0000:01:00.0)\r\n"]
[3.775, "o", "\u001b[32mPASS\u001b[0m  Driver package installed             nvidia-driver-550 550.120 (proprietary kernel modules)\r\n"]
[3.845, "o", "\u001b[31mFAIL\u001b[0m  Kernel module loaded                 The nvidia kernel module is not loaded\r\n"]
[3.915, "o", "      Without the kernel module no program can use the GPU. If you have just installed or upgraded\r\n"]
[3.985, "o", "      the driver, reboot first. Otherwise the checks below point at the usual causes: nouveau\r\n"]
[4.055, "o", "      holding the GPU, no module built for the running kernel, or Secure Boot rejecting an unsigned\r\n"]
[4.125, "o", "      module. Loading it by hand shows the kernel's exact error.\r\n"]
[4.195, "o", "      \u001b[1mSuggested commands (review before running):\u001b[0m\r\n"]
[4.265, "o", "        $ sudo modprobe nvidia\r\n"]
[4.335, "o", "        $ sudo dmesg | grep -iE 'nvidia|nouveau'\r\n"]
[4.405, "o", "\r\n"]
[4.475, "o", "\u001b[31mFAIL\u001b[0m  Module built for running kernel      DKMS has not built the nvidia module for the running kernel\r\n"]
[4.545, "o", "                                           6.8.0-47-generic\r\n"]
[4.615, "o", "      DKMS has nvidia 550.120 built only for: 6.8.0-45-generic. This usually happens after a kernel\r\n"]
[4.685, "o", "      upgrade when the matching linux-headers package was missing or the build failed. Install the\r\n"]
[4.755, "o", "      headers, rebuild, and reboot.\r\n"]
[4.825, "o", "      \u001b[1mSuggested commands (review before running):\u001b[0m\r\n"]
[4.895, "o", "        $ sudo apt install linux-headers-$(uname -r)\r\n"]
[4.965, "o", "        $ sudo dkms autoinstall\r\n"]
[5.035, "o", "        $ sudo reboot\r\n"]
[5.105, "o", "\r\n"]
[5.175, "o", "\u001b[31mFAIL\u001b[0m  Kernel headers installed             Kernel headers for 6.8.0-47-generic are not installed\r\n"]
[5.245, "o", "      DKMS compiles the nvidia module against the headers of each kernel. Without headers for the\r\n"]
[5.315, "o", "      running kernel it cannot build the module.\r\n"]
[5.385, "o", "      \u001b[1mSuggested commands (review before running):\u001b[0m\r\n"]
[5.455, "o", "        $ sudo apt install linux-headers-$(uname -r)\r\n"]
[5.525, "o", "        $ sudo dkms autoinstall\r\n"]
[5.595, "o", "\r\n"]
[5.665, "o", "\u001b[32mPASS\u001b[0m  No nouveau conflict                  nouveau is not loaded (blocked by\r\n"]
[5.735, "o", "                                           /lib/modprobe.d/nvidia-graphics-drivers.conf)\r\n"]
[5.805, "o", "\u001b[32mPASS\u001b[0m  Secure Boot and module signing       Secure Boot is disabled, so unsigned modules can load\r\n"]
[5.875, "o", "\u001b[2mSKIP\u001b[0m  Module and library versions match    Skipped: depends on 'Kernel module loaded', which did not pass\r\n"]
[5.945, "o", "\u001b[2mSKIP\u001b[0m  nvidia-smi works                     Commands are not run when inspecting another root\r\n"]
[6.015, "o", "\u001b[32mPASS\u001b[0m  CUDA toolkit compatible with driver  CUDA 12.4.1 is fully supported (needs driver >= 550.54.15)\r\n"]
[6.085, "o", "\u001b[2mSKIP\u001b[0m  Docker GPU support                   Docker is not installed\r\n"]
[6.155, "o", "\u001b[2mSKIP\u001b[0m  Hybrid graphics (PRIME)              Not a hybrid-graphics system\r\n"]
[6.225, "o", "\r\n"]
[6.295, "o", "6 passed, 0 warnings, 3 failed, 4 skipped. Nothing on this system was changed.\r\n"]
