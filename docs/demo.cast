[12.915, "o", "\u001b[1mgpu-doctor 0.1.0\u001b[0m: read-only NVIDIA driver diagnostics\r\n"]
[12.985, "o", "\r\n"]
[13.055, "o", "\u001b[32mPASS\u001b[0m  NVIDIA GPU present                 1 NVIDIA GPU: AD102 [GeForce RTX 4090] (0000:01:00.0)\r\n"]
[13.125, "o", "\u001b[32mPASS\u001b[0m  Kernel module loaded               nvidia kernel module 550.90.07 is loaded\r\n"]
[13.195, "o", "\u001b[31mFAIL\u001b[0m  Module and library versions match  Kernel module is 550.90.07 but the libraries are 550.120\r\n"]
[13.265, "o", "      This is the classic 'Failed to initialize NVML: Driver/library version mismatch'. The driver\r\n"]
[13.335, "o", "      was upgraded: the new libraries are already on disk but the old kernel module is still loaded.\r\n"]
[13.405, "o", "      Rebooting loads the new module.\r\n"]
[13.475, "o", "      \u001b[1mSuggested commands (review before running):\u001b[0m\r\n"]
[13.545, "o", "        $ sudo reboot\r\n"]
